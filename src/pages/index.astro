---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm';

const heroImage = 'https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?auto=format&fit=crop&w=2200&q=88';
const annaImage = 'https://images.unsplash.com/photo-1519682337058-a94d519337bc?auto=format&fit=crop&w=1200&q=85';
const studioImage = 'https://images.unsplash.com/photo-1552422535-c45813c61732?auto=format&fit=crop&w=1800&q=85';
const lessonImages = [
  'https://images.unsplash.com/photo-1507838153414-b4b713384a76?auto=format&fit=crop&w=900&q=82',
  'https://images.unsplash.com/photo-1510915361894-db8b60106cb1?auto=format&fit=crop&w=900&q=82',
  'https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?auto=format&fit=crop&w=900&q=82'
];
---

<Layout>
  <header id="site-header" class="fixed inset-x-0 top-0 z-50 text-white transition-all duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8 lg:px-10">
      <a href="#top" class="group flex items-center gap-3" aria-label="Fly to the Moon home">
        <span class="relative grid h-10 w-10 place-items-center overflow-hidden rounded-full border border-white/50">
          <span class="absolute -right-1 top-1 h-7 w-7 rounded-full bg-white"></span>
          <span class="absolute -left-1 top-0 h-7 w-7 rounded-full bg-night"></span>
          <span class="relative z-10 mt-2 text-sm">♪</span>
        </span>
        <span class="leading-none"><strong class="block text-[0.7rem] font-semibold uppercase tracking-[0.22em]">Fly to the Moon</strong><small class="mt-1 block text-[0.55rem] uppercase tracking-[0.27em] text-white/60">Piano &amp; Music Studio</small></span>
      </a>
      <nav id="desktop-nav" class="hidden items-center gap-7 text-[0.68rem] font-medium uppercase tracking-[0.14em] lg:flex" aria-label="Main navigation">
        <a class="transition-colors hover:text-brass" href="#about">About</a>
        <a class="transition-colors hover:text-brass" href="#lessons">Lessons</a>
        <a class="transition-colors hover:text-brass" href="#studio">Studio</a>
        <a class="transition-colors hover:text-brass" href="#philosophy">Philosophy</a>
        <a class="transition-colors hover:text-brass" href="#faq">FAQ</a>
        <a class="transition-colors hover:text-brass" href="#contact">Contact</a>
      </nav>
      <a href="#contact" class="hidden border border-white/60 px-4 py-2.5 text-[0.63rem] font-semibold uppercase tracking-[0.16em] transition-colors hover:border-brass hover:bg-brass lg:inline-flex">Book a trial</a>
      <button id="menu-toggle" type="button" class="grid h-10 w-10 place-items-center border border-white/50 text-xl lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">☰</button>
    </div>
    <div id="mobile-menu" class="hidden border-t border-white/15 bg-night/95 px-5 py-5 lg:hidden">
      <nav class="grid gap-4 text-xs font-medium uppercase tracking-[0.16em]" aria-label="Mobile navigation">
        <a href="#about">About</a><a href="#lessons">Lessons</a><a href="#studio">Studio</a><a href="#philosophy">Philosophy</a><a href="#faq">FAQ</a><a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero-image grain relative isolate min-h-[760px] overflow-hidden text-white sm:min-h-[820px]">
      <div class="relative z-10 mx-auto flex min-h-[760px] max-w-7xl items-end px-5 pb-20 pt-32 sm:min-h-[820px] sm:px-8 sm:pb-24 lg:px-10">
        <div class="max-w-3xl">
          <p class="eyebrow mb-6 text-white/70">Newcastle · Bellevue · Washington</p>
          <h1 class="font-display max-w-2xl text-6xl font-medium leading-[0.86] tracking-[-0.03em] sm:text-8xl">Let music take you further.</h1>
          <p class="mt-7 max-w-lg text-sm leading-7 text-white/80 sm:text-base">Private piano and music theory lessons for children and adults. Discover your sound, find your wings, and build a musical life that feels like your own.</p>
          <div class="mt-9 flex flex-wrap items-center gap-5">
            <a href="#contact" class="inline-flex items-center gap-3 bg-white px-6 py-4 text-xs font-semibold uppercase tracking-[0.17em] text-ink transition-colors hover:bg-brass hover:text-white">Book a trial <span aria-hidden="true">↗</span></a>
            <a href="#lessons" class="inline-flex items-center gap-2 border-b border-white/50 pb-2 text-xs font-semibold uppercase tracking-[0.17em] text-white transition-colors hover:border-brass hover:text-brass">Explore lessons <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-note absolute right-5 top-1/2 hidden w-64 -translate-y-1/2 border border-white/25 bg-night/35 p-3 backdrop-blur-md lg:block">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={lessonImages[1]} alt="Hands playing piano keys in the studio" class="h-full w-full object-cover" loading="eager" />
          </div>
          <div class="flex items-end justify-between gap-4 px-1 pb-1 pt-4">
            <div>
              <p class="eyebrow text-brass">The studio note</p>
              <p class="mt-2 max-w-[10rem] text-xs leading-5 text-white/75">A calm place to listen closely, practice bravely, and keep going.</p>
            </div>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/35 text-sm text-white">♪</span>
          </div>
        </div>
        <div class="absolute bottom-8 right-5 hidden max-w-[160px] text-right text-[0.58rem] uppercase leading-5 tracking-[0.25em] text-white/60 sm:block lg:right-10">A brighter<br />tomorrow<br />through music</div>
      </div>
    </section>


    <section id="about" class="scroll-mt-10 bg-paper py-20 sm:py-28 lg:py-36">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-20 lg:px-10">
        <div class="image-hover relative aspect-[4/5] overflow-hidden bg-mist">
          <img src={annaImage} alt="A piano student practicing near a bright window" loading="lazy" class="h-full w-full object-cover" />
          <div class="absolute bottom-5 left-5 border border-white/60 px-4 py-3 text-[0.58rem] uppercase leading-5 tracking-[0.23em] text-white">Music<br />People<br />Possibilities</div>
        </div>
        <div>
          <h2 class="max-w-xl font-display text-5xl leading-[0.92] text-ink sm:text-7xl">Meet Anna.</h2>
          <div class="mt-8 max-w-xl space-y-5 text-sm leading-7 text-ink/65"><p>Anna Zhu is a pianist, MTNA-certified piano educator, and the founder of Fly to the Moon Piano & Music Studio. She holds a master’s degree in Communication and Public Relations from Johns Hopkins University and has completed additional coursework in Child Psychology and Introduction to Psychology through Coursera, as well as online coursework focused on children with autism through the University of British Columbia.</p></div>
          <details class="expand-details mt-7 max-w-xl border-y border-ink/15">
            <summary class="py-4 text-xs font-semibold uppercase tracking-[0.16em] text-ink">Read Anna&apos;s full approach</summary>
            <div class="space-y-6 pb-6 text-sm leading-7 text-ink/65">
              <p>Her teaching experience includes working with children and adults of different ages, learning styles, and musical goals, including children on the autism spectrum and older adults living with dementia. These experiences have shaped her belief that there is no single “right” way to learn music. Patience, communication, trust, and an understanding of each student are at the heart of her teaching.</p>
              <p>Anna continues her own advanced piano studies with Victoria Bogdashevskaya, former principal pianist of the Seattle Symphony, bringing an active connection to professional musicianship into her teaching.</p>
              <p>At Fly to the Moon, Anna hopes to create more than piano lessons. She wants each student to feel heard, supported, challenged, and inspired—to develop strong musical foundations while discovering a personal and lasting connection with music.</p>
            </div>
          </details>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-ink/15 pt-5 text-[0.64rem] font-semibold uppercase tracking-[0.16em] text-ink/65"><span>Music</span><span>Communication</span><span>Understanding</span><span>Growth</span></div>
        </div>
      </div>
    </section>

    <section id="lessons" class="scroll-mt-10 bg-mist py-20 sm:py-28">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
        <div class="flex flex-col justify-between gap-6 border-b border-ink/15 pb-8 sm:flex-row sm:items-end">
          <div>
            <h2 class="font-display text-5xl leading-none text-ink sm:text-6xl">PIANO LESSONS</h2>
            <div class="mt-5 flex flex-wrap gap-2 text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-ink/65">
              <span class="border border-ink/15 bg-paper px-3 py-2">Children</span>
              <span class="border border-ink/15 bg-paper px-3 py-2">Adults</span>
              <span class="border border-ink/15 bg-paper px-3 py-2">Beginners</span>
              <span class="border border-ink/15 bg-paper px-3 py-2">Advanced</span>
            </div>
          </div>
          <p class="max-w-xs text-sm leading-6 text-ink/60">Learn at your own pace. Grow in your own way.</p>
        </div>

        <div class="mt-8 grid grid-cols-3 gap-2 sm:gap-4" aria-label="Studio lesson moments">
          {lessonImages.map((image, index) => (
            <figure class={`lesson-photo group relative overflow-hidden ${index === 1 ? 'aspect-[16/7]' : 'aspect-[16/9]'}`}>
              <img src={image} alt={['Student hands at the piano', 'A focused music practice moment', 'Piano keys ready for a new piece'][index]} loading="lazy" class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105" />
              <div class="absolute inset-0 bg-night/10 transition group-hover:bg-transparent"></div>
            </figure>
          ))}
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
          <div class="space-y-6">
            <p class="max-w-3xl text-base leading-8 text-ink/70">Every student comes to music with a different goal. Some want to play their favorite songs for fun, some dream of performing on stage, and others are preparing for examinations or competitions. Lessons are personalized around each student’s age, experience, learning style, and musical interests.</p>

            <div class="border border-ink/10 bg-paper p-6 sm:p-8">
              <h3 class="font-display text-4xl leading-none text-ink">Private Piano Lessons</h3>
              <div class="mt-6 space-y-5">
                <div class="border-b border-ink/10 pb-5">
                  <p class="eyebrow text-brass">30-Minute Lessons</p>
                  <p class="mt-3 text-sm leading-6 text-ink/65">Ideal for young beginners and students who benefit from shorter, focused weekly lessons.</p>
                </div>
                <div>
                  <p class="eyebrow text-brass">60-Minute Lessons</p>
                  <p class="mt-3 text-sm leading-6 text-ink/65">Recommended for intermediate and advanced students, exam or competition preparation, and students who would like more time for technique, repertoire, theory, and musicianship.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="grid gap-5">
            {[
              ['Children', 'Build a strong foundation through fun, focused, and imaginative lessons.'],
              ['Adults', 'It is never too late to start, restart, or make more room for music.'],
              ['Intermediate &amp; advanced', 'Refine technique, deepen expression, and reach the next goal.']
            ].map(([title, text]) => (
              <article class="border border-ink/10 bg-paper p-5">
                <p class="eyebrow text-brass">{title}</p>
                <p class="mt-3 text-sm leading-6 text-ink/65">{text}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="mt-12 border-t border-ink/15 pt-8">
          <p class="eyebrow text-brass">Areas of Study</p>
          <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            {[
              ['Play for Joy', 'Learn the music you love while developing strong foundations, confidence, and musical expression.'],
              ['RCM &amp; ABRSM Exam Preparation', 'Structured preparation in repertoire, technique, musicianship, and music theory for students pursuing RCM or ABRSM examinations.'],
              ['Competition &amp; Performance Preparation', 'Individualized coaching for students preparing for competitions, recitals, auditions, and other performance opportunities.'],
              ['Music Theory &amp; Musicianship', 'Theory can be incorporated into piano lessons or studied more intensively depending on each student’s goals.']
            ].map(([title, text]) => (
              <div class="border border-ink/10 bg-paper p-5">
                <h3 class="font-display text-2xl leading-none text-ink">{title}</h3>
                <p class="mt-3 text-sm leading-6 text-ink/65">{text}</p>
              </div>
            ))}
          </div>
        </div>

        <p class="mt-10 max-w-4xl text-base leading-8 text-ink/70">Whether your goal is your first song, your first recital, an examination, or a competition stage, there is a place for you here.</p>
      </div>
    </section>

    <section id="studio" class="scroll-mt-10 bg-paper py-20 sm:py-28">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:px-10">
        <div>
          
          <h2 class="mt-5 max-w-md font-display text-5xl leading-[0.92] text-ink sm:text-7xl">Studio</h2>

          <p class="mt-7 max-w-xl text-sm leading-7 text-ink/65">Fly to the Moon Piano &amp; Music Studio is a private teaching studio located in the <strong class="font-semibold text-ink">98059 area of Newcastle/Bellevue, Washington</strong>, serving students from Renton and surrounding communities.</p>
          <p class="mt-6 max-w-xl text-sm leading-7 text-ink/65">Centered around a grand piano, the studio is designed to provide a calm, welcoming, and focused environment where students can step away from everyday distractions and connect deeply with music.</p>
          <p class="mt-6 max-w-xl text-sm leading-7 text-ink/65">Whether a student is playing their very first note or preparing for an advanced performance, the studio is a place where curiosity is encouraged, mistakes are part of learning, and every musical milestone deserves to be celebrated.</p>
          <p class="mt-8 max-w-xl text-sm font-medium leading-6 text-ink/75">Detailed studio directions are provided upon lesson confirmation.</p>
          <a href="#contact" class="mt-8 inline-flex items-center gap-2 border-b border-ink pb-2 text-xs font-semibold uppercase tracking-[0.17em] text-ink transition-colors hover:border-brass hover:text-brass">Take a look inside <span aria-hidden="true">↗</span></a>
        </div>
        <div class="image-hover aspect-[16/10] overflow-hidden">
          <img src={studioImage} alt="Grand piano in a bright private music studio" loading="lazy" class="h-full w-full object-cover" />
        </div>
      </div>
      <div class="mx-auto mt-10 grid max-w-7xl grid-cols-2 gap-px border-y border-ink/10 bg-ink/10 px-5 sm:grid-cols-4 sm:px-8 lg:px-10">
        {[
          ['01', 'Private', 'One-to-one attention'],
          ['02', 'Welcoming', 'A calm, focused room'],
          ['03', 'Local', 'Newcastle · 98059'],
          ['04', 'Purposeful', 'Progress with joy']
        ].map(([number, title, text]) => (
          <div class="bg-paper px-4 py-5 sm:px-6">
            <p class="font-display text-2xl text-brass">{number}</p>
            <p class="mt-2 text-[0.65rem] font-semibold uppercase tracking-[0.15em] text-ink">{title}</p>
            <p class="mt-2 text-xs leading-5 text-ink/55">{text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="philosophy" class="scroll-mt-10 bg-night py-20 text-white sm:py-28">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="eyebrow text-brass">Teaching Philosophy</p>
            <h2 class="mt-5 max-w-sm font-display text-5xl leading-[0.92] sm:text-7xl">Music is more than notes.</h2>
            <div class="mt-6 flex flex-wrap gap-2 text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-white/70">
              <span class="border border-white/15 bg-white/5 px-3 py-2">Technique</span>
              <span class="border border-white/15 bg-white/5 px-3 py-2">Creativity</span>
              <span class="border border-white/15 bg-white/5 px-3 py-2">Expression</span>
              <span class="border border-white/15 bg-white/5 px-3 py-2">Confidence</span>
            </div>
            <p class="mt-8 max-w-sm text-base leading-8 text-white/70">Happy Learning. Meaningful Progress.</p>
            <p class="mt-4 max-w-sm text-sm leading-7 text-white/55">I believe students learn best when they feel safe, curious, understood, and excited to return to the piano.</p>
          </div>

          <div class="grid gap-0 border-t border-white/15">
            {[
              ['Joy Comes First', 'Music should be something students look forward to—not another source of pressure. Lessons encourage curiosity, creativity, and a genuine love of music while gradually building strong technique and musicianship.'],
              ['Every Student Is Different', 'No single teaching method works for everyone. Some students learn by listening. Some learn visually. Some need to move, imagine, tell stories, or understand the “why” behind what they are playing. My job is not simply to teach the lesson. It is to discover how each student learns best.'],
              ['Communication Is Essential', 'I want my students to know that their ideas matter. They are always encouraged to tell me: “I don’t understand.” “Can we try this another way?” “I really love this piece.” “This is difficult for me.” These conversations are not interruptions to learning—they are part of learning. A strong teacher-student relationship is built on trust, respect, and communication.'],
              ['Little Missions, Big Progress', 'Joyful learning does not mean learning without goals. Students may receive small weekly Music Missions—a technique challenge, a listening activity, a practice goal, a creative exercise, or a musical discovery to bring back to the next lesson. The goal is not perfection. The goal is to build curiosity, independence, consistency, and the confidence to keep moving forward.'],
              ['More Than Piano', 'Ultimately, I hope students leave the studio with more than the ability to play an instrument. I hope they learn how to listen, express themselves, overcome challenges, stay curious, and find confidence in their own voice.']
            ].slice(0, 2).map(([title, text], index) => (
              <div class="grid gap-3 border-b border-white/15 py-6 sm:grid-cols-[60px_0.55fr_1fr] sm:gap-6">
                <span class="font-display text-2xl text-brass">0{index + 1}</span>
                <h3 class="font-display text-2xl text-white">{title}</h3>
                <p class="text-sm leading-6 text-white/55">{text}</p>
              </div>
            ))}
            <details class="expand-details expand-details-dark border-b border-white/15">
              <summary class="py-5 text-xs font-semibold uppercase tracking-[0.16em] text-white">Explore three more principles</summary>
              <div>
                {[
                  ['Communication Is Essential', 'I want my students to know that their ideas matter. They are always encouraged to tell me: “I don’t understand.” “Can we try this another way?” “I really love this piece.” “This is difficult for me.” These conversations are not interruptions to learning—they are part of learning. A strong teacher-student relationship is built on trust, respect, and communication.'],
                  ['Little Missions, Big Progress', 'Joyful learning does not mean learning without goals. Students may receive small weekly Music Missions—a technique challenge, a listening activity, a practice goal, a creative exercise, or a musical discovery to bring back to the next lesson. The goal is not perfection. The goal is to build curiosity, independence, consistency, and the confidence to keep moving forward.'],
                  ['More Than Piano', 'Ultimately, I hope students leave the studio with more than the ability to play an instrument. I hope they learn how to listen, express themselves, overcome challenges, stay curious, and find confidence in their own voice.']
                ].map(([title, text], index) => (
                  <div class="grid gap-3 border-t border-white/15 py-6 sm:grid-cols-[60px_0.55fr_1fr] sm:gap-6">
                    <span class="font-display text-2xl text-brass">0{index + 3}</span>
                    <h3 class="font-display text-2xl text-white">{title}</h3>
                    <p class="text-sm leading-6 text-white/55">{text}</p>
                  </div>
                ))}
              </div>
            </details>
          </div>
        </div>

        <p class="mt-10 text-lg italic leading-8 text-white/80">Good music begins with good communication.</p>
      </div>
    </section>

    <section id="faq" class="scroll-mt-10 bg-paper py-20 sm:py-28">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.7fr_1.3fr] lg:px-10">
        <div>
          <p class="eyebrow text-brass">FAQ</p>
          <h2 class="mt-5 font-display text-5xl leading-none text-ink sm:text-6xl">Good questions<br />make good music.</h2>
        </div>
        <div class="border-t border-ink/20">
          {[
            ['How does tuition payment work?', 'Tuition is accepted via Zelle or cash and is due at the beginning of each month. Monthly tuition reserves the student’s regular weekly lesson time.'],
            ['What is the cancellation policy?', 'Please provide at least 24 hours’ notice if you need to cancel or reschedule a lesson. When sufficient notice is provided, a make-up lesson may be arranged based on studio availability.'],
            ['Do you offer make-up lessons?', 'Yes. Make-up lessons are available for eligible cancellations with at least 24 hours’ notice and are scheduled according to teacher and studio availability.'],
            ['Are recitals offered?', 'Yes! Studio recitals are offered twice each year, giving students the opportunity to share their progress, build confidence, and celebrate music with family and fellow students. Participation is encouraged but not required.'],
            ['Do you prepare students for competitions?', 'Absolutely. Students interested in competitions, auditions, examinations, or other performance opportunities are always welcome to discuss their goals with the teacher. Preparation plans can be developed according to the student’s level, timeline, and individual goals.'],
            ['Do you offer RCM or ABRSM preparation?', 'Yes. Lessons can include preparation for RCM and ABRSM examinations, including repertoire, technique, musicianship, and music theory.'],
            ['Are master lessons available?', 'For selected students seeking advanced musical development, opportunities for master lessons with university music professors and professional musicians may be available when appropriate. Please contact the studio to discuss whether this would be a good fit for the student’s current level and goals.'],
            ['What happens when the teacher is on vacation?', 'Planned studio vacations will generally be communicated at least one month in advance so families have plenty of time to plan accordingly.'],
            ['What if I have a question about lessons or my child’s progress?', 'Please reach out anytime. Communication between students, families, and the teacher is an important part of the learning process. Questions about practice, repertoire, progress, motivation, scheduling, or lesson goals are always welcome.']
          ].map(([question, answer]) => (
            <details class="faq-item border-b border-ink/15 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-sm font-semibold text-ink">{question}</summary>
              <p class="max-w-2xl pt-4 pr-8 text-sm leading-6 text-ink/60">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-mist py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
        <div class="flex items-end justify-between border-b border-ink/15 pb-8">
          <div>
            <p class="eyebrow text-brass">Student Stories</p>
            <h2 class="mt-4 font-display text-5xl leading-none text-ink sm:text-6xl">Family testimonials</h2>
          </div>
          <span class="hidden text-2xl tracking-[0.1em] text-brass sm:block">★★★★★</span>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-3">{[['“Anna is patient, encouraging, and truly cares about her students. Our daughter looks forward to every lesson.”', 'Parent of an 8-year-old student'], ['“Her teaching style is both professional and warm. We have grown so much in my playing and confidence.”', 'Adult student'], ['“A beautiful studio and a wonderful teacher. Fly to the Moon is the perfect place for anyone who loves music.”', 'Parent of a 7-year-old student']].map(([quote, by]) => (<blockquote class="testimonial-card border border-ink/10 bg-paper p-6"><span class="text-3xl text-brass">“</span><p class="mt-3 text-sm leading-6 text-ink/75">{quote.replace(/^“|”$/g, '')}</p><footer class="mt-7 flex items-center justify-between gap-3 text-[0.62rem] font-semibold uppercase tracking-[0.13em] text-ink/45"><span>{by}</span><span class="text-brass">★★★★★</span></footer></blockquote>))}</div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-10 bg-paper py-20 sm:py-28">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-start lg:px-10">
        <div>
          <p class="eyebrow text-brass">07 — Final CTA</p>
          <h2 class="mt-5 max-w-md font-display text-5xl leading-[0.92] text-ink sm:text-7xl">Ready to take flight?</h2>
          <p class="mt-7 max-w-sm text-sm leading-7 text-ink/60">Tell us a little about the student and what you hope to discover. We will reply with next steps and available trial lesson times.</p>
          <div class="mt-9">
            <a href="#contact" class="inline-flex items-center gap-2 border-b border-ink pb-2 text-xs font-semibold uppercase tracking-[0.17em] text-ink transition-colors hover:border-brass hover:text-brass">Book a Trial Lesson <span aria-hidden="true">→</span></a>
          </div>
          <div class="mt-9 space-y-3 border-t border-ink/15 pt-6 text-xs uppercase tracking-[0.15em] text-ink/55"><p>Seattle Eastside · Washington</p><p><a class="transition-colors hover:text-brass" href="mailto:hello@flytothemoon.studio">hello@flytothemoon.studio</a></p></div>
        </div>
        <BookingForm client:load />
      </div>
    </section>
  </main>

  <footer class="bg-night py-8 text-white"><div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 text-[0.6rem] uppercase tracking-[0.16em] text-white/50 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10"><span>© 2026 Fly to the Moon Piano &amp; Music Studio</span><div class="flex gap-5"><a href="#top" class="transition-colors hover:text-brass">Back to top ↑</a><a href="#contact" class="transition-colors hover:text-brass">Book a trial</a></div></div></footer>

  <script>
    const header = document.querySelector('#site-header');
    const toggle = document.querySelector('#menu-toggle');
    const menu = document.querySelector('#mobile-menu');

    const updateHeader = () => {
      header?.classList.toggle('header-scrolled', window.scrollY > 24);
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu?.classList.toggle('hidden', isOpen);
    });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.classList.add('hidden');
    }));
  </script>
</Layout>
