---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Fly to the Moon | Piano & Music Studio', description = 'Private piano and music theory lessons for children and adults in the Newcastle and Bellevue area.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17263d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
